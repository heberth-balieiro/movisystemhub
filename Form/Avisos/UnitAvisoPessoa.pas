implementation

{$R *.dfm}



procedure TFrmAvisoPessoa.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  FrmAvisoPessoa:= nil;
end;

procedure TFrmAvisoPessoa.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if key = VK_ESCAPE then
  begin
    FrmAvisoPessoa.Close;
    key:=0;
  end;
end;

procedure TFrmAvisoPessoa.FormShow(Sender: TObject);
begin
  edtaviso.EditValue    := msg;
end;

end.
