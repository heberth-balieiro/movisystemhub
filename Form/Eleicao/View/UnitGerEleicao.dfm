    ScriptLanguage = 'PascalScript'
    ScriptText.Strings = (
      ''
      'procedure Page1OnBeforePrint(Sender: TfrxComponent);'
      'var'
      
        'PNG,nFantasia, nCnpj, nEmail, nTelefone, nEnderecov, nNumero, nB' +
        'airro, nCep, nCidade:String;'
      'begin'
      ''
      '  nFantasia := VarToStr(<nfantasia>);'
      '  nCnpj     := VarToStr(<ncnpj>);'
      '  nEmail    := VarToStr(<nemail>);'
      '  nTelefone := VarToStr(<ntelefone>);'
      '  nEnderecov := VarToStr(<nendereco>);'
      '  nNumero   := VarToStr(<nnumero>);'
      '  nBairro   := VarToStr(<nbairro>);'
      '  nCep      := VarToStr(<ncep>);'
      '  nCidade   := VarToStr(<ncidade>);'
      '  PNG       := VarToStr(<wLogo>);'
      ''
      '  //receber foto da carteirinha'
      '  if PNG <> '#39#39' then //verifica se e diferente de vazio'
      '  nlogo.Picture.LoadFromFile(PNG);//carrega na tela'
      ''
      '  nrazao.Text          := nFantasia+'#39' | '#39'+nCnpj;'
      '  ncontatos.Text       := nEmail+'#39' - '#39'+ nTelefone;'
      
        '  nendereco.Text       := nEnderecov+'#39', '#39'+nNumero+'#39' - '#39'+nBairro+' +
        #39' | '#39'+nCep+'#39' - '#39'+nCidade;'
      ''
      'end;'
      ''
      'begin'
      ''
      'end.')
