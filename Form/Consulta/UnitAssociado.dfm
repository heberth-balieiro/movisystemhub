    object Memo1: TMemo
      Left = 558
      Top = 32
      Width = 337
      Height = 129
      Lines.Strings = (
        'Ativo: Associado regular, com todos os direitos.'
        'Inadimplente: Associado com pend'#234'ncias financeiras.'
        'Suspenso: Temporariamente fora de atividade.'
        'Inativo: Associado sem participa'#231#227'o, mas com v'#237'nculo.'
        'Cancelado: Associa'#231#245'es encerradas formalmente.'
        'Afastado: Temporariamente afastado por motivos '
        'diversos.'
        'Recadastramento Pendentes: Precisa atualizar dados.'
        'Em Processo de Regulariza'#231#227'o: Em processo de '
        'normalizar pend'#234'ncias.'
        'Provis'#243'rio: Associado em per'#237'odo de teste.'
        'Honor'#225'rio: Associado com status especial.'
        'Jubilado: Associado com isen'#231#227'o ou benef'#237'cios ap'#243's '
        'certo tempo.'
        'Tempor'#225'rio: Associado de v'#237'nculo tempor'#225'rio.'
        'Suspenso por Viola'#231#227'o: Suspens'#227'o por infra'#231#227'o de '
        'regras.'
        'Benef'#237'cios Suspensos: Benef'#237'cios suspensos, mas '
        'v'#237'nculo mantido.'
        'Em Recupera'#231#227'o: Associado com condi'#231#245'es especiais '
        'para recupera'#231#227'o.')
      TabOrder = 1
      Visible = False
    end
  end
